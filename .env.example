# Copiar a .env y rellenar con valores reales. .env NO se commitea.
#
# Para MULTI-INSTANCIA usa un archivo por usuario en instances/<usuario>.env
# (ver instances/example.env) y arrancalo con scripts/run_instance.ps1.
# Este .env sirve para una unica instancia en la raiz del proyecto.

# --- Supabase (cloud) — el bot usa la service-role key (bypassa RLS) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Identidad de la instancia (= auth.users.id del usuario) ---
USER_ID=<uuid_del_usuario>
SYMBOL=XAUUSD+
MAGIC_NUMBER=100100

# --- Attach a MetaTrader 5 (cuenta Vantage de esta instancia) ---
# Vacio => usa el terminal por defecto ya abierto.
MT5_PATH=
MT5_LOGIN=
MT5_SERVER=
MT5_PASSWORD=

# --- PostgreSQL local (legacy) — solo para scripts de migracion ---
DB_HOST=localhost
DB_NAME=sentinel_local
DB_USER=postgres
DB_PASS=tu_password_aqui
DB_PORT=5432
