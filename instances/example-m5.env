# Plantilla de instancia del GRINDER M5. Copiala a instances/<usuario>-m5.env
# (NO se commitea) y arrancala con:
#     scripts\run_instance.ps1 instances\<usuario>-m5.env
#
# Convive con la instancia M15 del MISMO usuario, contra la MISMA cuenta MT5
# y el MISMO terminal. Se separan por BOT_ID (filas en Supabase) y por
# MAGIC_NUMBER (posiciones en el broker).
#
# ANTES DE ARRANCAR:
#   1. Aplicar migrations/002_bot_id.sql.
#   2. Crear la fila bot_config con bot_id='m5' (ver el bloque SEED de esa
#      migracion) y la fila bot_instances correspondiente.
#   3. Actualizar el dashboard para filtrar por bot_id.
#   4. Primera vuelta con SHADOW_MODE=true (ver abajo).

# --- Supabase (misma URL/key que la instancia M15) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Identidad de ESTA instancia ---
# USER_ID y SYMBOL son LOS MISMOS que en el .env del M15: es el mismo usuario
# y la misma cuenta. Lo que cambia es BOT_ID y MAGIC_NUMBER.
USER_ID=<uuid_del_usuario_en_auth.users>
SYMBOL=XAUUSD+

BOT_ID=m5
MAGIC_NUMBER=100200
MODULE=bot.main_m5

# Magics de la cuenta: permiten a cada motor calcular la reserva de margen
# del otro leyendo MT5 directamente (bot/budget.py). Deben coincidir en AMBOS
# .env (el del M15 y el del M5).
MAGIC_M15=100100
MAGIC_M5=100200

# --- Terminal MetaTrader 5 (EL MISMO que el del M15) ---
MT5_PATH=C:\Program Files\MetaTrader 5 - Vantage\terminal64.exe
MT5_LOGIN=12345678
MT5_SERVER=VantageInternational-Live
MT5_PASSWORD=<password_de_la_cuenta>
