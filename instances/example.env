# Plantilla de instancia. Copiala a instances/<usuario>.env (NO se commitea)
# y arrancala con:  scripts\run_instance.ps1 instances\<usuario>.env
#
# Una instancia = un usuario = una cuenta Vantage = un terminal MT5.

# --- Supabase (misma URL/key para todas las instancias del proyecto) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Identidad de ESTA instancia ---
USER_ID=<uuid_del_usuario_en_auth.users>
SYMBOL=XAUUSD+
MAGIC_NUMBER=100100

# --- Terminal MetaTrader 5 de la cuenta Vantage de este usuario ---
MT5_PATH=C:\Program Files\MetaTrader 5 - Vantage\terminal64.exe
MT5_LOGIN=12345678
MT5_SERVER=VantageInternational-Live
MT5_PASSWORD=<password_de_la_cuenta>
