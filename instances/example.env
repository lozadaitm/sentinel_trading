# Plantilla de instancia. Copiala a instances/<usuario>.env (NO se commitea) y
# arrancala con:  scripts\start_all.ps1
#
# UN FICHERO POR USUARIO, no por bot.
# Una instancia = un usuario = una cuenta Vantage = un terminal MT5. Sobre esa
# misma cuenta pueden correr varios motores (Sentinel M15 y Grinder M5): comparten
# credenciales y solo difieren en BOT_ID y MAGIC_NUMBER, que los inyecta el
# launcher. No dupliques este fichero para el M5.

# --- Supabase (igual para todas las instancias del proyecto) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Identidad de ESTE usuario ---
USER_ID=<uuid_del_usuario_en_auth.users>
SYMBOL=XAUUSD+

# --- Motores a levantar sobre esta cuenta ---
# m15      -> solo el Sentinel (por defecto si se omite)
# m15,m5   -> Sentinel + Grinder M5
#
# Antes de añadir m5: aplicar migrations/002_bot_id.sql, crear su fila de
# bot_config/bot_instances (bloque SEED de esa migracion) y actualizar el
# dashboard para filtrar por bot_id. Primera vuelta con SHADOW_MODE=true.
BOTS=m15

# Magics de la cuenta. Deben ser DISTINTOS entre si: son lo que permite a cada
# motor ver solo sus posiciones y a la vez leer la cesta del vecino para calcular
# la reserva de margen (ver bot/budget.py).
MAGIC_M15=100100
MAGIC_M5=100200

# --- Terminal MetaTrader 5 de la cuenta Vantage de este usuario ---
MT5_PATH=C:\Program Files\MetaTrader 5 - Vantage\terminal64.exe
MT5_LOGIN=12345678
MT5_SERVER=VantageInternational-Live
MT5_PASSWORD=<password_de_la_cuenta>

# --- SMTP (opcional; notificaciones por correo, ver bot/notify.py) ---
# Sin SMTP_HOST no se envian correos (el evento igual queda en la DB).
# El destinatario es el email del usuario en auth.users.
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=alertas@tu-dominio.com
# SMTP_PASSWORD=<password_o_app_password>
# SMTP_FROM=Sentinel <alertas@tu-dominio.com>

# --- Opcional ---
# Modo sombra: los motores deciden y loguean, pero NO envian ordenes al broker.
# SHADOW_MODE=true
